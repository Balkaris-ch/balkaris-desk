# Installed on the box as `balkaris-desk.service`, running from
# /opt/balkaris-desk — a tarball deploy, not a git checkout, exactly like the
# engine next to it. See deploy/README.md.
#
# --experimental-sqlite: the queue is node:sqlite, which Node 22 keeps behind
# that flag. Nothing native is compiled, which is the point on a 3.7 GB box.
[Unit]
Description=Balkaris desk — the website's workbench
After=network-online.target
Wants=network-online.target

[Service]
# Runs as `deploy`, which owns /opt/balkaris-desk. Not root: the desk fetches
# arbitrary web pages and parses them with jsdom, which is the last thing that
# should have the box. It also means a person on the box can run
# `npm run intake` against the same database instead of meeting
# "attempt to write a readonly database".
User=deploy
Group=deploy
WorkingDirectory=/opt/balkaris-desk
ExecStart=/usr/bin/npm run start
Restart=always
RestartSec=5
Environment=NODE_ENV=production
Environment=DESK_DB=/opt/balkaris-desk/desk.db
# The box has 3.7 GB and the engine is the tenant that matters. A jsdom parse
# of a heavy page is the one thing here that eats memory, so this is set above
# what the queue and the HTML need and well below what the engine leaves.
MemoryMax=768M

[Install]
WantedBy=multi-user.target
