# balkaris-desk — NO PAID API KEYS LIVE ON THE WORKSTATION, ON PURPOSE.
# Every model call goes to Ollama on this machine, unless the owner switches the
# desk to Anthropic (Settings > Writing, or /ai in Telegram). Then the call goes
# to the desk server, which holds the key and counts the spend. See src/llm.ts
# and src/ai/claude.ts.
#
# On the box only (/opt/balkaris-desk/.env), optional: ANTHROPIC_API_KEY_DESK.
# Without it the desk reads the engine's shared ANTHROPIC_API_KEY from
# /opt/balkaris/.env (ENGINE_ENV_FILE), read, never copied.

# --- the local brain -------------------------------------------------------
OLLAMA_URL=http://127.0.0.1:11434
WRITE_MODEL=gemma4:26b
QUICK_MODEL=gemma4:12b-it-qat
OLLAMA_NUM_CTX=16384

# --- pictures (phase two) --------------------------------------------------
# ComfyUI on this machine, the same one Cinema Studio drives.
COMFY_URL=http://127.0.0.1:8189

# --- the front door --------------------------------------------------------
# From @BotFather. The VALUE lives in E:\Balkaris\secrets\desk-telegram-token.txt
# and is read into this file by hand — never committed, never printed.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=

# --- where a published post lands ------------------------------------------
# A clone of balkaris-web-infrastructure that belongs to the desk alone, so it
# never fights the working tree a person (or another session) is editing.
SITE_REPO=E:/Balkaris/Code/balkaris-site-publish
SITE_BRANCH=main

# --- the console behind the tunnel -----------------------------------------
DESK_PORT=3400
DESK_URL=https://desk.balkaris.ch
