{
  "name": "balkaris-desk",
  "version": "0.1.0",
  "description": "The website's workbench at desk.balkaris.ch — a Telegram link becomes a Balkaris article, written on this machine and committed to the site",
  "type": "module",
  "private": true,
  "scripts": {
    "match": "tsx --env-file-if-exists=.env scripts/match.ts",
    "check:catalogue": "tsx scripts/check-catalogue.ts",
    "typecheck": "tsc --noEmit",
    "server": "node --env-file-if-exists=.env --experimental-sqlite --disable-warning=ExperimentalWarning --import tsx src/server.ts",
    "start": "node --env-file-if-exists=.env --experimental-sqlite --disable-warning=ExperimentalWarning --import tsx src/server.ts",
    "runner": "tsx --env-file-if-exists=.env src/runner.ts",
    "intake": "node --env-file-if-exists=.env --experimental-sqlite --disable-warning=ExperimentalWarning --import tsx scripts/intake.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@mozilla/readability": "^0.6.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "hono": "^4.6.0",
    "jsdom": "^26.0.0",
    "tsx": "^4.19.0",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
